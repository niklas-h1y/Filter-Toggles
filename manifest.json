{
  "manifest_version": 3,
  "name": "Filter Matrix",
  "version": "1.5.0",
  "description": "A complete library of CSS, SVG, and creative visual filters for webpages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "filter-catalog.js",
        "content.js",
        "advanced-effects.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "filter-catalog.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
