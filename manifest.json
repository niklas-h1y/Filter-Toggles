{
  "manifest_version": 3,
  "name": "Filter Matrix",
  "version": "1.2.0",
  "description": "Fine-tune webpage colors, lighting, and creative visual effects.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
