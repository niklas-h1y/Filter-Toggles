{
  "manifest_version": 3,
  "name": "Multi-Filter Matrix",
  "version": "1.1.0",
  "description": "Adjust color, light, blur, opacity, and shadow filters on webpages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}